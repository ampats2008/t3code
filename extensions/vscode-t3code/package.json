{
  "name": "t3code-bridge",
  "displayName": "T3Code Bridge",
  "description": "Connect VS Code / Cursor to T3Code — send selections, receive file-open commands",
  "version": "0.1.0",
  "publisher": "t3tools",
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "t3code.sendSelection",
        "title": "Send to T3Code"
      },
      {
        "command": "t3code.submitReview",
        "title": "Submit Review to T3Code",
        "icon": "$(send)"
      },
      {
        "command": "t3code.createReviewComment",
        "title": "Add Comment"
      },
      {
        "command": "t3code.replyReviewComment",
        "title": "Reply"
      },
      {
        "command": "t3code.deleteReviewComment",
        "title": "Delete Comment",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "t3code.sendSelection",
          "when": "editorHasSelection",
          "group": "t3code"
        }
      ],
      "editor/title": [
        {
          "command": "t3code.submitReview",
          "group": "navigation",
          "when": "t3code.hasReviewComments"
        }
      ],
      "commandPalette": [
        {
          "command": "t3code.submitReview",
          "when": "t3code.hasReviewComments"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "t3code.deleteReviewComment",
          "group": "inline",
          "when": "commentController == t3code-review && !commentThreadIsEmpty"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "t3code.createReviewComment",
          "group": "inline",
          "when": "commentController == t3code-review && commentThreadIsEmpty"
        },
        {
          "command": "t3code.replyReviewComment",
          "group": "inline",
          "when": "commentController == t3code-review && !commentThreadIsEmpty"
        }
      ]
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "dev": "npm run build -- --watch",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.5.10",
    "esbuild": "^0.20.0"
  },
  "dependencies": {
    "ws": "^8.16.0"
  }
}
